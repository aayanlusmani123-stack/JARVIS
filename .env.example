GEMINI_API_KEY=your_gemini_api_key_here
# Optional; defaults to the current Gemini Flash model used by this project.
GEMINI_MODEL=gemini-3.8-flash
# Required only for authenticated Minecraft state updates and reads.
MINECRAFT_API_TOKEN=replace-with-a-long-random-secret
# Both flags are required to expose simulated Minecraft fixtures; keep disabled for live use.
JARVIS_ENV=production
MINECRAFT_DEV_TEST_MODE=false
# Screen vision is disabled until explicitly enabled on the server and in the dashboard.
MINECRAFT_VISION_ENABLED=false
